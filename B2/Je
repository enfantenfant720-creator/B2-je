-- AUTO ANTI DIE AU TP BAT (logique Evny)
-- ============================================================
_evnyAD = {
    enabled = false,
    heartConn = nil,
    deathConns = {},
    charConn = nil,
    humanoid = nil,
}
do
    local function stopADConns()
        for _, deathConnection in ipairs(_evnyAD.deathConns) do
            pcall(function()
                deathConnection:Disconnect()
            end)
        end
        _evnyAD.deathConns = {}
        if _evnyAD.heartConn then
            pcall(function()
                _evnyAD.heartConn:Disconnect()
            end)
            _evnyAD.heartConn = nil
        end
    end
    local function protectCharacterFromDeath(character)
        if not character then
            return
        end
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then
            return
        end
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge
        pcall(function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            humanoid.BreakJointsOnDeath = false
        end)
        _evnyAD.humanoid = humanoid
        table.insert(
            _evnyAD.deathConns,
            humanoid.StateChanged:Connect(function(old, new)
                if not _evnyAD.enabled then
                    return
                end
                if new == Enum.HumanoidStateType.Dead then
                    humanoid.Health = math.huge
                    pcall(function()
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                    end)
                end
            end)
        )
        table.insert(
            _evnyAD.deathConns,
            humanoid:GetPropertyChangedSignal("Health"):Connect(function()
                if _evnyAD.enabled and humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = math.huge
                end
            end)
        )
        if _evnyAD.heartConn then
            pcall(function()
                _evnyAD.heartConn:Disconnect()
            end)
        end
        _evnyAD.heartConn = RunService.Heartbeat:Connect(function()
            if _evnyAD.enabled and humanoid and humanoid.Parent and humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = math.huge
            end
        end)
    end
    _evnyADReapply = function(character)
        if not _evnyAD.enabled then
            return
        end
        protectCharacterFromDeath(character or LP.Character)
    end
    _evnyAD.start = function()
        _evnyAD.enabled = true
        stopADConns()
        protectCharacterFromDeath(LP.Character)
        if _evnyAD.charConn then
            pcall(function()
                _evnyAD.charConn:Disconnect()
            end)
        end
        _evnyAD.charConn = LP.CharacterAdded:Connect(function(character)
            if not _evnyAD.enabled then
                return
            end
            task.wait(0.1)
            stopADConns()
            protectCharacterFromDeath(character)
        end)
    end
    _evnyAD.stop = function()
        _evnyAD.enabled = false
        stopADConns()
        if _evnyAD.charConn then
            pcall(function()
                _evnyAD.charConn:Disconnect()
            end)
            _evnyAD.charConn = nil
        end
        local character = LP.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function()
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
                humanoid.MaxHealth = 100
                humanoid.Health = 100
            end)
        end
        _evnyAD.humanoid = nil
    end
end

