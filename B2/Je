            specialMesh:SetAttribute("YoutOutfitModifiedMesh", nil)
            specialMesh:SetAttribute("YoutOutfitOriginalMeshId", nil)
            specialMesh:SetAttribute("YoutOutfitOriginalTextureId", nil)
        end
    end
