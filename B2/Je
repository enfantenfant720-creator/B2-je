    stroke.Name = "RotatingBorderStroke"
    stroke.Thickness = thickness or 2
    stroke.Transparency = 0
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.LineJoinMode = Enum.LineJoinMode.Round
    local grad = Instance.new("UIGradient", stroke)
    grad.Name = "RotatingBorderGradient"
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,140,40)),
        ColorSequenceKeypoint.new(0.15, Color3.fromRGB(0,0,0)),
        ColorSequenceKeypoint.new(0.30, Color3.fromRGB(255,180,90)),
        ColorSequenceKeypoint.new(0.45, Color3.fromRGB(0,0,0)),
        ColorSequenceKeypoint.new(0.60, Color3.fromRGB(255,140,40)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(0,0,0)),
        ColorSequenceKeypoint.new(0.90, Color3.fromRGB(255,180,90)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(0,0,0)),
    })
    grad.Rotation = 0
    table.insert(_rotatingBorderGradients, grad)
    return stroke, grad
end

task.spawn(function()
    while true do
        task.wait(0.03)
        for i = #_rotatingBorderGradients, 1, -1 do
            local g = _rotatingBorderGradients[i]
            if g and g.Parent then g.Rotation = (g.Rotation + 4) % 360
            else table.remove(_rotatingBorderGradients, i) end
        end
    end
end)

