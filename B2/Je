local batDesyncTpEnabled = false
local batDesyncTpConn = nil
local batDesyncTpSetVisual = nil

-- Logique reprise de "MVP TP BATE"
-- V1 = hit automatique | V2 = il faut taper (clic / tap ecran / R2 / E / F) pour hit
local _TpBat = {
    version = "V1",
    speed = 40,          -- 10 a 80 : plus haut = hits plus rapproches
    hitCD = false,
    inputConn = nil,
}

function _TpBat.versionText()
    return _TpBat.version == "V2" and "V2 Tap to Hit" or "V1 Auto Hit"
end

function _TpBat.hitDelay()
    local t = 0.12 - ((_TpBat.speed - 10) / 70) * 0.105
    return math.clamp(t, 0.015, 0.12)
end

function _TpBat.isBatTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local n = string.lower(tool.Name)
    return n == "bat" or n:find("bat", 1, true) ~= nil or n:find("slap", 1, true) ~= nil
end

function _TpBat.getBat()
    local c = LP.Character
    if not c then return nil end
    local hum = c:FindFirstChildOfClass("Humanoid")
    for _, ch in ipairs(c:GetChildren()) do
        if _TpBat.isBatTool(ch) then return ch end
    end
    local bp = LP:FindFirstChildOfClass("Backpack") or LP:FindFirstChild("Backpack")
    if bp then
        for _, ch in ipairs(bp:GetChildren()) do
            if _TpBat.isBatTool(ch) then
                if hum then
                    pcall(function() hum:EquipTool(ch) end)
                else
                    pcall(function() ch.Parent = c end)
                end
                return ch
            end
        end
    end
    return nil
end

function _TpBat.hit()
    if _TpBat.hitCD then return end
    _TpBat.hitCD = true
    pcall(function()
        local bat = _TpBat.getBat()
        if not bat then return end
        pcall(function() bat:Activate() end)
        for _, d in ipairs(bat:GetDescendants()) do
            if d:IsA("RemoteEvent") then
                pcall(function() d:FireServer() end)
            end
        end
        local ev = bat:FindFirstChildWhichIsA("RemoteEvent")
        if ev then pcall(function() ev:FireServer() end) end
    end)
    task.delay(_TpBat.hitDelay(), function() _TpBat.hitCD = false end)
end

function _TpBat.closest(myHrp)
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local tr = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and tr and tr.Parent then
                local d = (myHrp.Position - tr.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = p
                end
            end
        end
    end
    return best, bestDist
end

function _TpBat.setHidden(inst, prop, value)
    pcall(function()
        local fn = sethiddenproperty or set_hidden_property or sethiddenprop or set_hidden_prop
        if fn then fn(inst, prop, value) end
    end)
end

local function batDesyncTpUpdate()
    if not batDesyncTpEnabled then stopBatDesyncTp(); return end
    local c = LP.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local target, dist = _TpBat.closest(hrp)
    if not target or not target.Character then return end
    local tr = target.Character:FindFirstChild("HumanoidRootPart")
    if not tr then return end

    -- desync
    _TpBat.setHidden(hrp, "PhysicsRepRootPart", tr)

    local targetPos = tr.Position + Vector3.new(0, 0.9, 0)
    if dist > 4 then
        hrp.CFrame = CFrame.new(targetPos, tr.Position)
    elseif dist > 1.5 then
        hrp.CFrame = CFrame.new(hrp.Position:Lerp(targetPos, 0.55), tr.Position)
    else
        hrp.CFrame = CFrame.new(targetPos, tr.Position)
    end
    pcall(function() hrp.AssemblyAngularVelocity = Vector3.zero end)

    local cam = workspace.CurrentCamera
    if cam then
        cam.CFrame = CFrame.new(cam.CFrame.Position, tr.Position + Vector3.new(0, 0.5, 0))
    end

    -- V1 : hit automatique (V2 : hit seulement quand tu tapes)
    if _TpBat.version == "V1" then
        _TpBat.hit()
    end
end

function updateTpBatButtonWithAntiDie(on)
    if bypassFloatingButton then
        local btnFrame = bypassFloatingButton:FindFirstChild("Frame")
        if btnFrame then
            paintFloatingBtn(btnFrame, on)
        end
    end
end

function startBatDesyncTp()
    if batDesyncTpConn then return end
    if _G.AmbitiousSafeModeTryStart and not _G.AmbitiousSafeModeTryStart() then return end
    _tpBatAutoAntiDie(true)
    batDesyncTpEnabled = true
    bypassToggled = true
    _G.Lust.Active.bypass = true
    batDesyncTpConn = RunService.Heartbeat:Connect(batDesyncTpUpdate)
    if _TpBat.inputConn then _TpBat.inputConn:Disconnect() end
    _TpBat.inputConn = UIS.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if not batDesyncTpEnabled or _TpBat.version ~= "V2" then return end
        if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch
            or inp.KeyCode == Enum.KeyCode.ButtonR2
            or inp.KeyCode == Enum.KeyCode.ButtonX
            or inp.KeyCode == Enum.KeyCode.ButtonA
            or inp.KeyCode == Enum.KeyCode.E
            or inp.KeyCode == Enum.KeyCode.F
        then
            _TpBat.hit()
        end
    end)
    _G.Lust.Connections.bypass = batDesyncTpConn
    if batDesyncTpSetVisual then batDesyncTpSetVisual(true) end
    updateTpBatButtonWithAntiDie(true)
end

function stopBatDesyncTp()
    if batDesyncTpConn then batDesyncTpConn:Disconnect(); batDesyncTpConn = nil end
    if _TpBat.inputConn then _TpBat.inputConn:Disconnect(); _TpBat.inputConn = nil end
    _G.Lust.Connections.bypass = nil
    batDesyncTpEnabled = false
    bypassToggled = false
    _G.Lust.Active.bypass = false
    _TpBat.hitCD = false
    _tpBatAutoAntiDie(false)
    if batDesyncTpSetVisual then batDesyncTpSetVisual(false) end
    updateTpBatButtonWithAntiDie(false)
end

function toggleBatDesyncTp()
    if batDesyncTpEnabled then
        stopBatDesyncTp()
    else
        disableAllAimbots()
        if autoLeftEnabled then
            autoLeftEnabled = false; stopAutoLeft()
            if autoLeftSetVisual then autoLeftSetVisual(false) end
            if mobSetAutoLeft then mobSetAutoLeft(false) end
        end
        if autoRightEnabled then
            autoRightEnabled = false; stopAutoRight()
            if autoRightSetVisual then autoRightSetVisual(false) end
            if mobSetAutoRight then mobSetAutoRight(false) end
        end
        startBatDesyncTp()
    end
    if batDesyncTpSetVisual then batDesyncTpSetVisual(batDesyncTpEnabled) end
    saveAllSettings()
end

