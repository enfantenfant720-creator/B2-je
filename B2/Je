                ColorSequenceKeypoint.new(1, Color3.fromRGB(215, 105, 25)),
            })
        end
        if textLabel then textLabel.TextColor3 = Color3.fromRGB(15, 15, 18) end
        if uiStroke then
            uiStroke.Color = Color3.fromRGB(255, 255, 255)
            uiStroke.Thickness = 1.8
            uiStroke.Transparency = 0.05
        end
    else
